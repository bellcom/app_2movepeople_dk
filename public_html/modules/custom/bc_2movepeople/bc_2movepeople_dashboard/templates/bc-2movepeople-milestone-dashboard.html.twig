{{ attach_library('bc_2movepeople_dashboard/bc_2movepeople_dashboard.accordion') }}
{{ attach_library('drupal.date') }}
<div id="form-system-messages"></div>
<div class="demo">
  <h2>{{ subtitle  }}</h2>
  <a href="{{ path('bc_2movepeople_dashboard_milestone.add', {'user': user}) }}" class="btn btn-info use-ajax" data-dialog-type="modal" data-dialog-options='{"width":640}' role="button">{{ 'Add new milestone'|trans }}</a>
  <br/><br/>
  <div id="accordion">
    {% for milestone_target in milestone_targets %}
      <h3 data-progression-id="{{ milestone_target.id }}">
        <a href="#">{{ milestone_target.title }}</a>
      </h3>
      <div>
        {{ milestone_target.form }}     
      </div>
    {% endfor %}
  </div>
</div>