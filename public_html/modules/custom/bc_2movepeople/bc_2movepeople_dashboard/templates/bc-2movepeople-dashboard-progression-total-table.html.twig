<div id="progression_total_table">
<table  class="table table-striped table-bordered">
  <thead>
    <tr>
      {% for column in table_header %}
        <th data-target="col_{{ loop.index }}"> {{ column }} </th>
        {% endfor %}
    </tr>
  </thead>
  {% for row in table_data %}
    <tr>
      {% for column in row %}
        <td data-target="col_{{ loop.index }}"> {{ column }} </td>
      {% endfor %}
    </tr>
  {% endfor %}
</table>
</div>
