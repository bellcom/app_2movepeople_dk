{{ attach_library('bc_2movepeople_dashboard/bc_2movepeople_dashboard.user-tasks') }}

{% macro recursiveTasks(tasks, user) %}
  
  {% for task in tasks %}
    <div class="row" id="task-row-{{task.id}}">
      <div class="col-sm-2"></div>
      <div class="col-sm-6 user-task-box">
        <div class="row">
          <div class="col-sm-10">
            {{ task.title }}<br/>
            {{ 'Date'|trans }}: {{ task.date|date("d-m-Y") }}
          </div>
          <div class="col-sm-2">
            <a href="{{ path('bc_2movepeople_dashboard_user_task.complete', {'user': user, 'node': task.id}) }}" class="btn btn-info use-ajax link-btn" data-dialog-type="modal" data-dialog-options='{"width":640}' role="button">{{ 'Complete'|trans }}</a>
          </div>
        </div>
      </div>
      <div class="col-sm-2"></div>
    </div>
    {% if task.subgoals is not null %}
      {{ _self.recursiveTasks(task.subgoals, user) }}
    {% endif %}
  {% endfor %}
  
{% endmacro %}

{{ _self.recursiveTasks(tasks, user) }}