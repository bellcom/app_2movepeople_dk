{#

/**
 * @file
 * Template file for js_example module.
 */
#}
{{ attach_library('bc_2movepeople_dashboard/bc_2movepeople_dashboard.accordion') }}
{{ attach_library('bc_2movepeople_rate_progression/bc_2movepeople_rate_progression.charts') }}
{{ attach_library('drupal.date') }}
<div class="demo">
  <h2>{{ subtitle  }}</h2>
  <a href="{{ path('bc_2movepeople_dashboard_progression.add', {'user': user}) }}" class="btn btn-info" role="button">{{ 'Add new progression'|trans }}</a>
  <br/><br/>
  <div id="accordion">
    {% for progression_target in progression_targets %}
      <h3 data-progression-id="{{ progression_target.id }}">
        <a href="#">{{ progression_target.title }}</a>
        <a class="btn btn-default btn-sm btn-progress use-ajax"  data-dialog-type = "modal" href="/rates/{{ progression_target.id }}/add">Rate progression</a>
      </h3>
      <div>
        <div class="div-goals">
          {% for goal in progression_target.goals %}
            <p> {% if goal.type == 'task' %} <span class="task {% if goal.completed %} completed {% else %} uncompleted {% endif %} ">&nbsp;</span> {% endif %} {% if goal.subgoals %} <a data-toggle="collapse" href="#subgoals_{{ goal.id }}" class="has-child" > {% endif %} 
             {{ goal.title }} {% if goal.type == 'task' %} ({{ goal.date|date("d.m.Y H:i")}}){% endif %}
              <span id="progress_rates_{{ progression_target.id }}_{{ goal.id }}">
{#                {% for rate in goal.rates %}
                  {{ rate }}
                {% endfor %}#}
              </span>
              {% if goal.subgoals %} </a > {% endif %}
            </p>
            {% if goal.subgoals %}
            <div id = "subgoals_{{ goal.id }}" class='collapse subgoals'>
            {% for subgoal in goal.subgoals %}
              
              <p> {{ subgoal.title }}
              <span id="progress_rates_{{ progression_target.id }}_{{ subgoal.id }}">
{#                {% for rate in subgoal.rates %}
                  {{ rate }}
                {% endfor %}#}
              </span>
            </p>
            {% endfor %}  
          </div>
           {% endif %} 
          {% endfor %}
        </div>
        <div class = "div-chart" id="div_chart_{{ progression_target.id }}">
        </div>
        <div class="div-form row form-inline" id="div_form_{{ progression_target.id }}" style="display:none">
          <div class='col-sm-4'>
            <input type='input' class="datepicker" id ="date_from_{{ progression_target.id }}" placeholder="From date"/>
          </div>
          <div class='col-sm-4'>
            <input type='input' class="datepicker" id ="date_to_{{ progression_target.id }}" placeholder="To date" />
          </div>
          <div class='col-sm-4'>
            <button type="button" class="btn btn-default btn-update" data-progression-id="{{ progression_target.id }}" id="update_graph_{{ progression_target.id }}">Update graph</button>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div id="dialog-message" title="Notification">
    <p>
      Not found rates in selected period
    </p>
  </div>
</div><!-- End demo -->
