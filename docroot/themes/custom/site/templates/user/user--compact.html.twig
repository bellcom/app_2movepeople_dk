<article{{ attributes }}>

  {# Begin - image #}
  <div class="user__image">
    <a href="/dashboard/users/{{ uid }}/overview">
      {{ content.user_picture }}
    </a>
  </div>
  {# End - image #}

  {% if user.field_user_firstname.value and user.field_user_surname.value %}
    {# Begin - heading #}
    <div class="user__heading">
      <a href="/dashboard/users/{{ uid }}/overview">
        <h4 class="user__heading__title">
          {{ user.field_user_firstname.value }} {{ user.field_user_surname.value }}
        </h4>
      </a>
    </div>
    {# End - heading #}
  {% endif %}

  <!-- Begin - controls -->
  <div class="user__controls">

    {% if content.masquerade %}
      {# Begin - masquerade #}
      <div class="user__controls__item user__controls__item--masquerade" title="{{ 'Switch to this user' | t }}" data-toggle="tooltip" data-placement="top">
        {{ content.masquerade }}
      </div>
      {# End - masquerade #}
    {% endif %}

    <!-- Begin - managers -->
    <a href="{{ path('bc_2movepeople_dashboard.user.edit_managers', {'user': user.id, 'destination': '/dashboard'}) }}" class="btn btn-default btn-sm use-ajax glyphicon-user" data-dialog-type="modal" data-dialog-options='{"width":500}' title="{{'Managers' | trans }}" data-toggle="tooltip" data-placement="top"></a>
    <!-- End - managers -->

    <!-- Begin - edit -->
    <a href="{{ path('bc_2movepeople_dashboard.user.edit', {'user': user.id, 'destination': '/dashboard'}) }}" class="btn btn-default btn-sm use-ajax glyphicon-edit" data-dialog-type="modal" title="{{'Edit' | trans }}" data-toggle="tooltip" data-placement="top"></a>
    <!-- End - edit -->

    <!-- Begin - cancel -->
    <a href="{{ path('bc_2movepeople_dashboard.user.cancel', { 'user': user.id, 'destination': '/dashboard' }) }}" class="btn btn-default btn-sm use-ajax glyphicon-remove" data-dialog-type="modal" title="{{ 'Remove' | trans }}" data-toggle="tooltip" data-placement="top"></a>
    <!-- End - cancel -->

  </div>
  <!-- End - controls -->

</article>
