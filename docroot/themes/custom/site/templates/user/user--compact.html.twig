<article{{ attributes }}>

  {# Begin - image #}
  <div class="user__image">
    <a href="/dashboard/users/{{ uid }}/overview">
      {{ content.user_picture }}
    </a>
  </div>
  {# End - image #}

  {% if user.field_user_firstname.value and user.field_user_surname.value %}
    {# Begin - heading #}
    <div class="user__heading">
      <a href="/dashboard/users/{{ uid }}/overview">
        <h4 class="user__heading__title">
          {{ user.field_user_firstname.value }} {{ user.field_user_surname.value }}
        </h4>
      </a>
    </div>
    {# End - heading #}
  {% endif %}

  <!-- Begin - controls -->
  <div class="user__controls">

    {% if content.masquerade %}
      {# Begin - masquerade #}
      <div class="user__controls__item user__controls__item--masquerade hidden" title="{{ 'Switch to this user' | t }}" data-toggle="tooltip" data-placement="top">
        {{ content.masquerade }}
      </div>
      {# End - masquerade #}
    {% endif %}

    {% if user.hasRole('2mp_user') %}
    <a href="{{ path('bc_2movepeople_dashboard.user.edit_managers', {'user': user.id, 'destination': destination}) }}" class="btn btn-default btn-sm use-ajax glyphicon-user" data-dialog-type="modal" data-dialog-options='{"width":500}' title="{{'Managers' | trans }}" data-toggle="tooltip" data-placement="top"></a>
    {% endif %}

    <!-- Begin - edit -->
    <a href="{{ path('bc_2movepeople_dashboard.user.edit', {'user': user.id, 'destination': destination}) }}" class="btn btn-default btn-sm use-ajax glyphicon-edit" data-dialog-type="modal" title="{{'Edit' | trans }}" data-toggle="tooltip" data-placement="top"></a>
    <!-- End - edit -->

    <a href="{{ path('bc_2movepeople_dashboard.user.cancel', { 'user': user.id, 'destination': destination }) }}" class="btn btn-default btn-sm use-ajax glyphicon-remove {% if has_connected_users %}disabled{% endif %}" data-dialog-type="modal" title="{{ 'Remove' | trans }}" data-toggle="tooltip" data-placement="top"></a>

    {% if last_min_rate %}
      {% if last_min_rate > 3 %}
        {# green color #}
        {% set rate_class = "btn btn-sm btn-success" %}
      {% elseif last_min_rate == 3 %}
        {# yellow color #}
        {% set rate_class = "btn btn-sm btn-warning" %}
      {% else %}
        {# red color #}
        {% set rate_class = "btn btn-sm btn-danger" %}
      {% endif %}

      <div class="{{ rate_class }}">
        {{ last_min_rate_text}}
      </div>
    {% endif %}

  </div>
  <!-- End - controls -->

</article>
