<?php

use Drupal\node\Entity\Node;
use Drupal\bc_2movepeople\Form\TextSettings;
use Drupal\field\Entity\FieldStorageConfig;
use Symfony\Component\Yaml\Yaml;
use Drupal\field\Entity\FieldConfig;

function bc_2movepeople_dashboard_schema() {
  $schema['bc_2movepeople_dashboard_task_reminder'] = array(
    'description' => 'This table stores reminded tasks',
    'fields' => array(
      'nid' => array(
        'description' => 'Goal id',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'reminded_count' => array(
        'description' => 'Reminded count (1..n)',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'email' => array(
        'description' => 'User is email of who got last remind',
        'type' => 'varchar',
        'length' => 64,
        'default' => '',
        'not null' => TRUE,
      ),
      'reminded_date' => array(
        'description' => 'Timestamp of last remind',
        'type' => 'int',
        'unsigned' => TRUE,
      ),
    ),
    'primary key' => array('nid'),
  );
  return $schema;
}

/**
 * Add default value for field 'field_task_show_complete_button'.
 */
function bc_2movepeople_dashboard_update_8001() {
  $node_goal_definition = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'goal');
  if (empty($node_goal_definition['field_task_show_complete_button'])
    || empty($node_goal_definition['field_task_links'])) {
    return;
  }

  $query = \Drupal::entityQuery('node');
  $query->condition('status', 1);
  $query->condition('type', 'goal');
  $query->notExists('field_task_links');
  $query->notExists('field_task_show_complete_button');
  $nids = $query->execute();
  /** @var \Drupal\node\NodeInterface $node */
  foreach (Node::loadMultiple($nids) as $node) {
    $node->set('field_task_show_complete_button', ['value' => 1])->save();
  }
}

/**
 * Add default text and titles.
 */
function bc_2movepeople_dashboard_update_8902(&$sandbox) {
  $config = \Drupal::service('config.factory')->getEditable(TextSettings::$config_name);
  $config->set('bc_2movepeople_dashboard.manager_tasks', t('Manager tasks'));
  $config->save();
}


function bc_2movepeople_dashboard_update_8903() {
 // Add new fields.
  $path = drupal_get_path('module', 'bc_2movepeople_dashboard');
  // Create field storage.
  $field_storage_yml = Yaml::parse(file_get_contents($path . '/config/optional/field.storage.node.field_related_tasks.yml'));
  if (!FieldStorageConfig::loadByName($field_storage_yml['entity_type'], $field_storage_yml['field_name'])) {
    FieldStorageConfig::create($field_storage_yml)->save();
  }
  // Create field instance.
  $field_yml = Yaml::parse(file_get_contents($path . '/config/optional/field.field.node.progression_target.field_related_tasks.yml'));
  if (!FieldConfig::loadByName($field_yml['entity_type'], $field_yml['bundle'], $field_yml['field_name'])) {
    FieldConfig::create($field_yml)->save();
  }
}  