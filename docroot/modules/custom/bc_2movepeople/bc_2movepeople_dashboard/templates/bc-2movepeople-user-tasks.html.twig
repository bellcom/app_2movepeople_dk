{{ attach_library('bc_2movepeople_dashboard/bc_2movepeople_dashboard.user-tasks') }}

{% macro recursiveTasks(tasks, user, subgoal) %}
  {% set attributes = create_attribute() %}
  {% for task in tasks %}
    {% set is_remind_class = (task.is_remind ? (task.is_remind == 2 ? 'is-remind-expired' : 'is-remind-warning') : '') %}
    {%
      set classes = [
      'col-lg-8 col-md-8 col-sm-6 col-xs-12',
      subgoal ? 'subtask',
      is_remind_class ? is_remind_class,
    ]
    %}
    <div class="row user-task-box" id="task-row-{{task.id}}">
      <div{{ attributes.addClass(classes) }}">
	      <span class="dashboard-overview-task-title">{{ task.title }}</span><br/>
	      <span class="dashboard-overview-task-date">{{ 'Date'|trans }}: {{ task.date|date("d-m-Y") }}</span>
      </div>
      <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 right-btn-box">
        <a href="{{ path('bc_2movepeople_dashboard.user.task.complete', {'user': user, 'node': task.id}) }}" class="btn btn-info use-ajax link-btn" data-dialog-type="modal" data-dialog-options='{"width":640}' role="button">{{ 'Complete'|trans }}</a>
      </div>
    </div>
    {% if task.subgoals is not null %}
      {{ _self.recursiveTasks(task.subgoals, user, 1) }}
    {% endif %}
  {% endfor %}
  
{% endmacro %}

<div class="dashboard-overview dashboard-overview-task-rows">
{{ _self.recursiveTasks(tasks, user, 0) }}
</div>
