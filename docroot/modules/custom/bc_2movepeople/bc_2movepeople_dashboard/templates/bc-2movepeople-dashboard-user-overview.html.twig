{{ attach_library('bc_2movepeople_rate_progression/bc_2movepeople_rate_progression.charts') }}


<div class="dashboard-overview">
  <div class="dashboard-overview__control-buttons">
    <a class="btn btn-default" href="{{ path('bc_2movepeople_dashboard.user.progressions', {'user': user}) }}">{{ 'Show category'|trans }}</a>
    <a class="btn btn-default btn-progress use-ajax"  data-dialog-type = "modal" href="/rates/user/{{ user }}/add">{{ 'Rate category'|trans }}</a>
  </div>
  <div class="dashboard-divider clearfix"></div>
  {% if table_progression is defined %}
    {{ table_progression }}
  {% endif %}
  <div class="progression-chart">
    <div class="text-center">
      <div class="btn-group graph-type-btn" data-toggle="buttons">
        <label class="btn btn-default active">
          <input type="radio" name="chart_type" class="line-graph-btn" autocomplete="off" checked> Line
        </label>
        <label class="btn btn-default">
          <input type="radio" name="chart_type" class="bar-graph-btn" autocomplete="off"> Bar
        </label>
      </div>
    </div>
    <div id="progression_total_chart">
    </div>
  </div>
  {% if table_milestone %}
  <div style="margin-top:50px">&nbsp;</div>
  <div class="dashboard-overview__control-buttons">
    <a class="btn btn-default" href="{{ path('bc_2movepeople_dashboard.user.milestones', {'user': user}) }}">{{ 'Show Target Milestones'|trans }}</a>
  </div>  
  <div class="clearfix"></div>
    {{ table_milestone }}
  {% endif %}  
</div>
