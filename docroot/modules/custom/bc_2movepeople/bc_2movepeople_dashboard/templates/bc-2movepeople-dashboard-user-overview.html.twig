{{ attach_library('bc_2movepeople_rate_progression/bc_2movepeople_rate_progression.charts.total') }}


<div class="dashboard-overview">
  {{ table_progression.controls }}
  {{ table_progression.message }}
  <div class="dashboard-divider clearfix"></div>
  {% if table_progression.data %}
    {{ table_progression.data }}
    <div class="progression-chart">
      <div class="text-center">
        <div class="btn-group graph-type-btn" data-toggle="buttons">
          <label class="btn btn-default active">
            <input type="radio" name="chart_type" class="line-graph-btn" autocomplete="off" checked> {{ 'Line graph' | trans }}
          </label>
          <label class="btn btn-default">
            <input type="radio" name="chart_type" class="bar-graph-btn" autocomplete="off"> {{ 'Bar' | trans }}
          </label>
          <label class="btn btn-default">
            <input type="radio" name="chart_type" class="radar-graph-btn" autocomplete="off"> {{ 'Radar' | trans }}
          </label>
        </div>
      </div>
      <div id="progression_total_chart"></div>
{#      <canvas id="radarChart" class="hidden" width="400" height="400"></canvas>#}
    </div>
  {% endif %}
  {% if table_milestone %}
  <div style="margin-top:50px">&nbsp;</div>
  {{ table_milestone.controls }}
    <div class="clearfix"></div>
    {% if table_milestone.data %}
      {{ table_milestone.data }}
    {% endif %}
  {% endif %}
  {% if table_progression.empty %}
    <strong>
      {{ table_progression.empty }}
    </strong>
  {% endif %}

</div>
