{{ attach_library('bc_2movepeople_rate_progression/bc_2movepeople_rate_progression.charts.total') }}


<div class="dashboard-overview">
  {% if table_milestone %}
    {{ table_milestone.controls }}
    <div class="clearfix"></div>
    {% if table_milestone.data %}
      {{ table_milestone.data }}
    {% endif %}
    <div style="margin-top:50px">&nbsp;</div>
  {% endif %}

  {% for progression_type, progression in progressions %}
    {% if progression.empty %}
      <strong>
        {{ progression.empty }}
      </strong>
    {% endif %}

    <h2>{{ progression.title }}</h2>
    {{ progression.controls }}
    {{ progression.message }}
    <div class="dashboard-divider clearfix"></div>
    {% if progression.data %}
      {{ progression.data }}
      <div class="progression-chart">
        <div class="text-center">
          <div class="btn-group graph-type-btn" data-toggle="buttons">
            <label class="btn btn-default active">
              <input type="radio" name="chart_type-{{ progression_type }}" class="line-graph-btn" autocomplete="off" checked> {{ 'Line graph' | trans }}
            </label>
            <label class="btn btn-default">
              <input type="radio" name="chart_type-{{ progression_type }}" class="bar-graph-btn" autocomplete="off"> {{ 'Bar' | trans }}
            </label>
            <label class="btn btn-default">
              <input type="radio" name="chart_type-{{ progression_type }}" class="radar-graph-btn" autocomplete="off"> {{ 'Radar' | trans }}
            </label>
          </div>
        </div>
        <div id="progression_total_chart"></div>
      </div>
    {% endif %}
    <div style="margin-top:50px">&nbsp;</div>
  {% endfor %}
</div>
