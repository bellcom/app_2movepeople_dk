{#

/**
 * @file
 * Template file for js_example module.
 */
#}
{#{{ attach_library('bc_2movepeople_dashboard/bc_2movepeople_dashboard.accordion') }}#}
{{ attach_library('bc_2movepeople_rate_progression/bc_2movepeople_rate_progression.charts.dashboard') }}

<div id="form-system-messages"></div>

<div class="dashboard-overview">
  <h2 class="subtitle">{{ subtitle }}</h2>
  {% if isSuperviser  %}
    <div class="dashboard-overview__control-buttons">
        <a href="{{ path('bc_2movepeople_dashboard.user.progressions.add', {'user': user, 'limit': limit}) }}"
         class="btn btn-default use-ajax" data-dialog-type="modal" data-dialog-options='{"width":640}'
         role="button">{{ 'Add new category'|trans }}</a>
    </div>
   {% endif %}
    <div class="dashboard-accordion panel-group" id="accordion-progressions" role="tablist" aria-multiselectable="true">
      {% for progression_target in progression_targets %}
        <div class="panel panel-default">
          <div class="panel-heading" role="tab" id="accordion-progressions-heading-{{ progression_target.id }}" data-progression-id="{{ progression_target.id }}">
            <a role="button" data-toggle="collapse" data-parent="#accordion-progressions"
               href="#accordion-progressions-collapse-{{ progression_target.id }}"
               aria-expanded="{% if loop.first %}true{% else %}false{% endif %}"
               aria-controls="accordion-progressions-collapse-{{ progression_target.id }}">
                <span class="glyphicon glyphicon-triangle-custom" aria-hidden="true"></span>
                {{ progression_target.title }}
            </a>
          </div>
          <div id="accordion-progressions-collapse-{{ progression_target.id }}"
               class="panel-collapse collapse {% if loop.first %} in {% endif %}" role="tabpanel"
               aria-labelledby="accordion-progressions-heading-{{ progression_target.id }}">
              <div class="panel-body">
                  <div>
                    <div class="row">
                     {% if isSuperviser  %}
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 left-btn-box">
                          <a href="{{ path('bc_2movepeople_dashboard.progressions.edit', {'node': progression_target.id, 'limit': limit}) }}"
                             class="btn btn-default btn-sm btn-progress">{{ 'Edit category'|trans }}</a>
                        </div>
                      {% endif %}
                          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 right-btn-box">
                            {% if progression_target.goals is empty %}
                              {{ 'There is no question in categories to rate it' |trans }}
                            {% else %}
                              <a class="btn btn-default btn-sm btn-progress use-ajax"  data-dialog-type="modal"
                                href="/rates/{{ progression_target.id }}/add">{% if limit == 'feedback' %}{{ 'Giv din feedback' | trans }} {% else %} {{ 'Svar på spørgsmål' | trans }}{% endif %}</a>
                            {% endif %}
                           </div>
                    </div>
                    {% if progression_target.goals %}
                      <div class="div-goals">
                        {% for goal in progression_target.goals %}
                          <p> {% if goal.type == 'task' %} <span class="task {% if goal.completed %} completed {% else %} uncompleted {% endif %} ">&nbsp;</span> {% endif %} {% if goal.subgoals %} <a data-toggle="collapse" href="#subgoals_{{ goal.id }}" class="has-child" > {% endif %}
                           {{ goal.title }} {% if goal.type == 'task' %} ({{ goal.date|date("d.m.Y H:i")}}){% endif %}
                           <span id="progress_rates_{{ progression_target.id }}_{{ goal.id }}">
                           </span>
                            {% if goal.subgoals %} </a > {% endif %}
                          </p>
                          {% if goal.subgoals %}
                          <div id="subgoals_{{ goal.id }}" class='collapse subgoals'>
                          {% for subgoal in goal.subgoals %}

                            <p> {{ subgoal.title }}
                            <span id="progress_rates_{{ progression_target.id }}_{{ subgoal.id }}">
                            </span>
                          </p>
                          {% endfor %}
                        </div>
                         {% endif %}
                        {% endfor %}
                      </div>
                      <div class="text-center">
                        <div class="btn-group graph-type-btn" data-toggle="buttons">
                          <label class="btn btn-default active">
                            <input type="radio" name="chart_type-{{ progression_target.id }}" class="line-graph-btn" autocomplete="off" data-progression-id="{{ progression_target.id }}" value="{{ 'Line' | trans }}" checked> {{ 'Linje' | trans }}
                          </label>
                          <label class="btn btn-default">
                            <input type="radio" name="chart_type-{{ progression_target.id }}" class="bar-graph-btn" autocomplete="off" data-progression-id="{{ progression_target.id }}" value="{{ 'Bar' | trans }}"> {{ 'Søjle' | trans }}
                          </label>
                          <label class="btn btn-default">
                            <input type="radio" name="chart_type-{{ progression_target.id }}" class="radar-graph-btn" autocomplete="off" data-progression-id="{{ progression_target.id }}" value="{{ 'Radar' | trans }}"> {{ 'Radar' | trans }}
                          </label>
                        </div>
                      </div>
                      <div class="div-chart" {% if progression_target.feedback %} progression="feedback" {% else %} progression="progress"  {% endif %} id="div_chart_{{ progression_target.id }}"></div>
{#                      <canvas id="radarChart" class="hidden" width="400" height="400"></canvas>#}
                      <div class="div-form form-item row form-inline" id="div_form_{{ progression_target.id }}" style="display:none">
                        <div class='col-lg-4 col-md-4 col-sm-6 col-xs-12'>
                          <label for="date_from_{{ progression_target.id }}" class="control-label">{{ 'From date' | trans}} </label>
                          <input type="date" class="form-date form-control " id="date_from_{{ progression_target.id }}" placeholder="{{ 'From date' | trans }}"/>
                        </div>
                        <div class='col-lg-4 col-md-4 col-sm-6 col-xs-12'>
                          <label for="date_to_{{ progression_target.id }}" class="control-label">{{ 'To date' | trans}} </label>
                          <input type="date" class="form-date form-control " id ="date_to_{{ progression_target.id }}" placeholder="{{ 'To date' | trans }}"/>
                        </div>
                        <div class='col-lg-4 col-md-4 col-sm-12 col-xs-12 right-btn-box'>
                          <button type="button" class="btn btn-default btn-update" data-progression-id="{{ progression_target.id }}" id="update_graph_{{ progression_target.id }}">{{ 'Update graph' | trans }}</button>
                        </div>
                      </div>
                    {% endif %}
                  </div>
              </div>
          </div>
        </div>
      {% endfor %}
    </div>
</div>
