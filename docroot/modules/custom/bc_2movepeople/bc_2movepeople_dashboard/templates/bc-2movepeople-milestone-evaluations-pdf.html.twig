{#

/**
 * @file
 * Template file for getMilestoneEvaluationsPdf.
 */
#}
<style>
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  .ev-header {
    margin-bottom: 10px;
  }
  .ev-header h1 {
    margin: 0;
    font-size: 44px;
    font-weight: bold;
  }
  .ev-header p {
    margin: 0;
  }
</style>

<div class="milestone-evaluation">
  <div class="ev-header">
    {{ header }}
  </div>

  {% if name %}
    <div>
      {{ name }}
    </div>
  {% endif %}

  {% if social_security_number %}
    <div>
      {{ 'Social security number' | trans }}: {{ social_security_number }}
    </div>
  {% endif %}

  <div>
    {{ 'Date' | trans }}: {{ 'now' | date('d.m.Y') }}
  </div>

  <br>

  {% for item in milestones_data %}
    <h1>{{ item.milestone.name }}</h1>
    <p>{{ item.milestone.purpose }}</p>

    <h2>{{ 'Evaluering' | trans }}</h2>
    <p>
      {% for target in item.targets %}
        <strong>{{ target.name }}</strong>
        <br>
        {{ target.evaluation }}
        <br><br>
      {% endfor %}
    </p>
  {% endfor %}
</div>
