{#

/**
 * @file
 * Template file for getMilestoneEvaluationsPdf.
 */
#}
<style>
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  .ev-header {
    margin-bottom: 10px;
  }
  .ev-header h1 {
    margin: 0;
    font-size: 44px;
    font-weight: bold;
  }
  .ev-header p {
    margin: 0;
  }
</style>

<div class="milestone-evaluation">
  <div class="ev-header">
    {{ header }}
  </div>

  {% if name %}
    <div>
      {{ name }}
    </div>
  {% endif %}

  {% if social_security_number %}
    <div>
      {{ 'Social security number' | trans }}: {{ social_security_number }}
    </div>
  {% endif %}

  <div>
    {{ 'Date' | trans }}: {{ 'now' | date('d.m.Y') }}
  </div>

  <br>
  <table style="width: 100%; border-collapse: collapse;" border="1" cellpadding="5px">
  {% for item in milestones_data %}
    {% if item.milestone.status != 'not_active' %}
        <tr>
          <td><h2>{{ 'Mål' | trans }}</h2></td>
          <td><h2>{{ item.milestone.name }}</h2></td>
        </tr>
        <tr>
          <td><h3>{{ 'Formål' | trans }}</h3></td>
          <td><h3>{{ item.milestone.purpose }}</h3></td>
        </tr>
        <tr>
          <td><h3>{{ 'Delmål' | trans }}</h3></td>
          <td><h3>{{ 'Evaluering' | trans }}</h3></td>
        </tr>
        {% for target in item.targets %}
          <tr>
            <td>{{ target.name }}</td>
            <td>{{ target.evaluation }}</td>
          </tr>
        {% endfor %}
    {% endif %}
  {% endfor %}
  </table>
</div>
