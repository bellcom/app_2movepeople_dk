<div id="form-system-messages"></div>

<h2>{{ subtitle  }}</h2>
<a href="{{ path('bc_2movepeople_dashboard.user.milestones.add', {'user': user}) }}" class="btn btn-default use-ajax" data-dialog-type="modal" data-dialog-options='{"width":640}' role="button">{{ 'Add new milestone'|trans }}</a>

<div class="panel-group" id="accordion-milestones" role="tablist" aria-multiselectable="true">
    {% for milestone_target in milestone_targets %}
        <div class="panel panel-default">
            <div class="panel-heading" role="tab" id="accordion-milestones-heading-{{ milestone_target.id }}">
                <h4 class="panel-title">
                    <a role="button" data-toggle="collapse" data-parent="#accordion-milestones" href="#accordion-milestones-collapse-{{ milestone_target.id }}" aria-expanded="{% if loop.first %} true {% else %} false {% endif %}" aria-controls="accordion-milestones-collapse-{{ milestone_target.id }}">
                        {{ milestone_target.title }}
                    </a>
                </h4>
            </div>
            <div id="accordion-milestones-collapse-{{ milestone_target.id }}" class="panel-collapse collapse {% if loop.first %} in {% endif %}" role="tabpanel" aria-labelledby="accordion-milestones-heading-{{ milestone_target.id }}">
                <div class="panel-body">
                    {{ milestone_target.form }}
                </div>
            </div>
        </div>
    {% endfor %}
</div>