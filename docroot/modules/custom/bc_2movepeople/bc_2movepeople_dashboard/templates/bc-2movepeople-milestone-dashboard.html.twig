<div id="form-system-messages"></div>

<div class="dashboard-overview">
  <h2 class="subtitle">{{ subtitle }}</h2>

  <div class="row dashboard-milestone__control-buttons left-btn-box">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 left-btn-box">
      <a href="{{ path('bc_2movepeople_dashboard.user.milestones.add', {'user': user}) }}"
         class="btn btn-default use-ajax" data-dialog-type="modal" data-dialog-options='{"width":640}'
         role="button">{{ 'Add new milestone'|trans }}</a>
    </div>
  </div>

  <div class="dashboard-accordion panel-group" id="accordion-milestones" role="tablist" aria-multiselectable="true">
    {% for milestone_target in milestone_targets %}
      <div class="panel panel-default">
        <div class="panel-heading" role="tab" id="accordion-milestones-heading-{{ milestone_target.id }}">
          <a role="button" data-toggle="collapse" data-parent="#accordion-milestones"
             href="#accordion-milestones-collapse-{{ milestone_target.id }}"
             aria-expanded="{% if loop.first %}true{% else %}false{% endif %}"
             aria-controls="accordion-milestones-collapse-{{ milestone_target.id }}">
            <span class="glyphicon glyphicon-triangle-custom" aria-hidden="true"></span>
            {{ milestone_target.title }} 
            <a href="{{ path('bc_2movepeople_dashboard.milestone.evaluate', {'node': milestone_target.id})}}" id="btn-evaluering" class="use-ajax btn btn-default" data-dialog-type="modal" >{{ 'Evaluering'|trans }}</a>
          </a>
        </div>
        <div id="accordion-milestones-collapse-{{ milestone_target.id }}"
             class="panel-collapse collapse{% if loop.first %} in{% endif %}" role="tabpanel"
             aria-labelledby="accordion-milestones-heading-{{ milestone_target.id }}">
          <div class="panel-body">
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 left-btn-box">
              <a href="{{ path('bc_2movepeople_dashboard.milestone.edit', {'node': milestone_target.id}) }}" 
                 class="btn btn-default btn-sm btn-progress">{{ 'Edit milestone'|trans }}</a>
            </div>
            {{ milestone_target.form }}

          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>