{#

/**
 * @file
 * Template file for getMilestoneEvaluations.
 */
#}
{{ message }}
<div class="milestone-evaluation">
  {% for item in milestones_data %}
    <h2>{{ item.milestone.name }}</h2>
    <a href="{{ path('bc_2movepeople_dashboard.milestone.evaluate', {'node':item.milestone.id, modal: TRUE})}}"
      id="btn-evaluering"
      data-dialog-type="modal"
      class="btn btn-default btn-sm pull-right use-ajax">
      {{ 'Edit'|trans }}
    </a>
    <p>{{ item.milestone.purpose }}</p>
    <div class="ev-list">
      <h3>{{ 'Evaluering' |trans}}</h3>
      {% for target in item.targets %}
        <div class="ev-item">
          <h4>{{ target.name }}</h4>
          <p>{{ target.evaluation }}</p>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
  <div class="milestone-evaluation-footer">
    <a href="{{ path('bc_2movepeople_dashboard.milestone.evaluations.pdf', {'user': user})}}" id="btn-evaluering" class="btn btn-default">{{ 'Save as PDF'|trans }}</a>
  </div>
</div>
