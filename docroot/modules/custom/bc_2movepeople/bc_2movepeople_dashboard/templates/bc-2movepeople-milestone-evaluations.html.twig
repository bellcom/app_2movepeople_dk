{#

/**
 * @file
 * Template file for getMilestoneEvaluations.
 */
#}

{{ message }}

<div class="milestone-evaluation">

  {% for item in milestones_data %}
    <div class="milestone-evaluation__item">
      <h2>{{ item.milestone.name }}</h2>

      <a href="{{ path('bc_2movepeople_dashboard.milestone.evaluate', {'node':item.milestone.id})}}"
         id="btn-evaluering"
         data-dialog-type="dialog"
         class="btn btn-default btn-sm pull-right btn-progress use-ajax">
        {{ 'Edit'|trans }}
      </a>

      <p>{{ item.milestone.purpose }}</p>

      <div class="ev-list">
        <h4>{{ 'Evaluering' |trans}}</h4>
        {% for target in item.targets %}

          <div class="ev-item">
            <p>
              <strong>{{ target.name }}</strong>
              <br>
              {{ target.evaluation }}
            </p>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}

  <div class="milestone-evaluation-footer">
    <a href="{{ path('bc_2movepeople_dashboard.milestone.evaluations.pdf', {'user': user})}}" class="btn btn-default">{{ 'Save as PDF'|trans }}</a>
    {% if (sbsys_enabled) %}
      <a href="{{ path('bc_2movepeople_dashboard.milestone.evaluations.sbsys', {'user': user})}}" class="btn btn-default">{{ 'Send data to SBSYS'|trans }}</a>
    {% endif %}
  </div>
</div>
