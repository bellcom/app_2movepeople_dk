{% set custom_class = '' %}
{% if type == 'progression' %}
  {% set custom_class = 'table-unbordered-сhessboard' %}
  {% set f = 1 %}
{% endif %}
{% if type == 'milestone' %}
  {% set custom_class = 'table-bordered-сustom' %}
{% endif %}

<div id="{{ type }}_total_table">
<table  class="table table-bordered {{ custom_class }}">
{#<table  class="table table-striped table-bordered">#}
  <thead>
    {% if custom_class == 'table-unbordered-сhessboard' %}
      <tr class="row_odd">
    {% else %}
      <tr>
    {% endif %}
      {% for column_header in table_header %}
        <th data-target="col_{{ loop.index }}"> {{ column_header }} </th>
        {% endfor %}
    </tr>
  </thead>  
  {% for row in table_data %}
    {% if custom_class == 'table-unbordered-сhessboard' %}
      {% set f = f + 1 %}
      {% if f%2 %}
        <tr class="row_odd">
      {% else %}
        <tr class="row_even">
      {% endif %}
    {% else %}
      <tr>
    {% endif %}
      {% for column_data in row %}
        <td data-target="col_{{ loop.index }}">
          <span class="column-header-box" data-label="{{ table_header[loop.index-1] }}"></span>
          <span class="column-data-box">{% if column_data != '0' %}{{column_data }}{% endif %}</span>
        </td>
      {% endfor %}
      </tr>
  {% endfor %}
</table>
</div>
